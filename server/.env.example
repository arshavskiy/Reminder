# Server port
PORT=3737

# Session cookie overrides. Leave empty for automatic local/dev/prod defaults.
# Railway/HTTPS deployments auto-use Secure + SameSite=None. handcoded.tech
# and remindocr.com frontends auto-use a shared parent Domain cookie so
# frontend/API subdomains share auth.
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=
COOKIE_DOMAIN_AUTO=true

# Logging
# In production logs are JSON; in development logs are human-readable.
# Supported levels: debug, info, warn, error.
LOG_LEVEL=info

# OpenAI API key/model (for document extraction)
OPENAI_LOCAL_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI extraction pacing. The OpenAI organization TPM/burst limit is controlled
# by OpenAI, not by this app. These values only tune local retry/pacing behavior.
AI_RATE_LIMIT_MAX_ATTEMPTS=5
AI_RATE_LIMIT_BASE_WAIT_MS=750
AI_RATE_LIMIT_MIN_WAIT_MS=500
AI_RATE_LIMIT_MAX_WAIT_MS=20000

# Batch processing pacing. Lower values are faster but can increase 429 risk.
# Uploads default to immediate processing; rescan-all defaults to a small stagger.
DOCUMENT_UPLOAD_START_STAGGER_MS=0
DOCUMENT_RESCAN_START_STAGGER_MS=1200

# Optional: override data directory (default: ./data)
DATA_DIR=

# Upload quota for role 'user' (pro and admin are unlimited)
USER_DOCUMENT_LIMIT=25

# Optional S3-compatible object storage, used by Railway Buckets.
# Railway bucket variables can be added automatically with "Add to Service".
ENDPOINT=
REGION=auto
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# Optional aliases also supported by the app.
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_FORCE_PATH_STYLE=false

# Legacy DigitalOcean Spaces variables are still supported.
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN_URL=

# Public email assets (logos/posters). Set BUCKET_PUBLIC_URL to a sending-domain
# URL such as https://assets.handcoded.tech so email image URLs align with the
# sender domain and are not embedded as base64.
BUCKET_PUBLIC_ENDPOINT=
BUCKET_PUBLIC_REGION=auto
BUCKET_PUBLIC_NAME=
BUCKET_PUBLIC_ACCESS_KEY_ID=
BUCKET_PUBLIC_SECRET_ACCESS_KEY=
BUCKET_PUBLIC_FORCE_PATH_STYLE=false
BUCKET_PUBLIC_URL=

# Transactional email — auth verification, password reset, magic links,
# reminder emails. Use either Resend or SMTP. EMAIL_FROM must be verified
# with the selected provider.
RESEND_API_KEY=

# SMTP works with any SMTP provider. Example values for Brevo
# (https://app.brevo.com/settings/keys/smtp — free tier: 300 emails/day):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=<your Brevo account email>
#   SMTP_PASS=<your Brevo SMTP key, not your account password>
#   EMAIL_FROM=<a sender verified in Brevo>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=ReminderOCR

# Web Push (admin browser notifications). Generate a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is served to the client via /api/admin/push/vapid-key; the
# private key stays server-only. Without these, push is silently disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
