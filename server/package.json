{
  "name": "reminder-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --disable-warning=DEP0040 --import tsx/esm src/index.ts",
    "dev:watch": "nodemon",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:magic-link": "tsx src/scripts/createMagicLinkUser.ts",
    "pdf:hebrew": "tsx src/scripts/parseHebrewPdf.ts",
    "pdf:hebrew:fields": "tsx src/scripts/parseHebrewPdf.ts --fields-only",
    "pdf:hebrew:ocr": "tsx src/scripts/parseHebrewPdf.ts --ocr-only",
    "ocr:audit-flow": "tsx src/scripts/auditPdfOcrFlow.ts",
    "report:send-all": "tsx src/scripts/sendMonthlyReportEmail.ts all",
    "report:send-both": "tsx src/scripts/sendMonthlyReportEmail.ts send-both",
    "report:send-client": "tsx src/scripts/sendMonthlyReportEmail.ts client",
    "report:send-client-monthly-owner": "tsx src/scripts/sendMonthlyReportEmail.ts client-monthly-owner",
    "report:send-client-future-owner": "tsx src/scripts/sendMonthlyReportEmail.ts client-future",
    "report:send-client-future": "tsx src/scripts/sendMonthlyReportEmail.ts send-client-future",
    "report:send-client-links": "tsx src/scripts/sendMonthlyReportEmail.ts client-links",
    "report:send-client-future-links": "tsx src/scripts/sendMonthlyReportEmail.ts client-future-links",
    "clients:merge-duplicates": "tsx src/scripts/mergeDuplicateClients.ts",
    "storage:test": "tsx src/scripts/testObjectStorage.ts",
    "storage:migrate-documents": "tsx src/scripts/migrateDocumentsToStorage.ts",
    "storage:migrate-documents:dry": "tsx src/scripts/migrateDocumentsToStorage.ts --dry",
    "documents:thumbnails": "tsx src/scripts/backfillPdfThumbnails.ts",
    "invoices:rescan": "tsx src/scripts/rescanInvoices.ts --apply",
    "invoices:rescan:dry": "tsx src/scripts/rescanInvoices.ts",
    "invoices:retry-missing": "tsx src/scripts/retryMissingInvoices.ts --apply",
    "invoices:retry-missing:dry": "tsx src/scripts/retryMissingInvoices.ts",
    "invoices:known-receipts": "tsx src/scripts/backfillKnownInvoiceReceipts.ts --apply",
    "invoices:known-receipts:dry": "tsx src/scripts/backfillKnownInvoiceReceipts.ts",
    "invoices:rejection-labels": "tsx src/scripts/backfillInvoiceRejectionLabels.ts --apply",
    "invoices:rejection-labels:dry": "tsx src/scripts/backfillInvoiceRejectionLabels.ts",
    "invoices:dedupe": "tsx src/scripts/removeDuplicateInvoices.ts --apply",
    "invoices:dedupe:dry": "tsx src/scripts/removeDuplicateInvoices.ts",
    "doc-templates:seed": "tsx src/scripts/seedDocTemplates.ts",
    "print-templates:seed-inspections": "tsx src/scripts/seedInspectionPrintTemplates.ts",
    "print-templates:seed-inspections:apply": "tsx src/scripts/seedInspectionPrintTemplates.ts --apply",
    "inspector-leads:seed": "tsx src/scripts/seedInspectorLeads.ts",
    "inspector-leads:seed:apply": "tsx src/scripts/seedInspectorLeads.ts --apply",
    "inspector-leads:create-trial-users": "tsx src/scripts/createTrialUsersFromInspectorLeads.ts",
    "inspector-leads:create-trial-users:apply": "tsx src/scripts/createTrialUsersFromInspectorLeads.ts --apply",
    "inspection-type:backfill": "tsx src/scripts/backfillInspectionType.ts",
    "inspection-type:backfill:apply": "tsx src/scripts/backfillInspectionType.ts --apply",
    "reminder-category-split:backfill": "tsx src/scripts/backfillReminderCategorySplit.ts",
    "reminder-category-split:backfill:apply": "tsx src/scripts/backfillReminderCategorySplit.ts --apply",
    "templates:sync-prod": "tsx src/scripts/syncEmailTemplateToProduction.ts --apply",
    "templates:sync-prod:dry": "tsx src/scripts/syncEmailTemplateToProduction.ts",
    "gmail:seed-search-providers": "tsx src/scripts/seedGmailSearchProviders.ts",
    "gmail:cleanup-rejected": "tsx src/scripts/cleanupRejectedGmailImports.ts --apply",
    "gmail:cleanup-rejected:dry": "tsx src/scripts/cleanupRejectedGmailImports.ts",
    "users:plans": "tsx src/scripts/backfillUserPlans.ts --apply",
    "users:plans:dry": "tsx src/scripts/backfillUserPlans.ts",
    "users:free-to-trial": "tsx src/scripts/migrateFreeUsersToTrial.ts --apply",
    "users:free-to-trial:dry": "tsx src/scripts/migrateFreeUsersToTrial.ts",
    "contracts:revert-reminder-advances": "tsx src/scripts/revertContractReminderAdvances.ts --apply",
    "contracts:revert-reminder-advances:dry": "tsx src/scripts/revertContractReminderAdvances.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@hebcal/core": "^5.9.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sparticuz/chromium": "^131.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.0.3",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "fontkit": "^1.9.0",
    "mammoth": "^1.8.0",
    "mongodb": "^6.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "nodemon": "^3.1.14",
    "openai": "^4.52.7",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.14.0",
    "puppeteer-core": "^25.6.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^5.1.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^6.4.15",
    "@types/pdf-parse": "^1.1.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "tesseract.js": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.0": true
  }
}
