{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "preserve",
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@server/*": ["src/server/*"],
      "@client/*": ["src/client/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "../dist",
    // Tests are not deployed, and some of them import the client copy of a
    // shared module to assert the two stay in step. Railway builds only the
    // server directory, so that path does not exist there and `tsc --noEmit`
    // failed the build over a file it was never going to ship. Vitest still
    // typechecks these when it runs.
    "src/__tests__"
  ]
}
